<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><!doctype html><html><head><title>Students</title><link rel="stylesheet" href="${pageContext.request.contextPath}/style.css"></head><body><main><header><h1>Students</h1><form method="post" action="${pageContext.request.contextPath}/logout"><button>Logout</button></form></header><form method="get"><input name="q" placeholder="Search name or enrollment"><button>Search</button></form><p><a href="${pageContext.request.contextPath}/students?action=new">+ Add Student</a></p><table><tr><th>Enrollment</th><th>Name</th><th>Email</th><th>Course</th><th>Actions</th></tr><c:forEach items="${students}" var="s"><tr><td><c:out value="${s.enrollmentNo}"/></td><td><c:out value="${s.fullName}"/></td><td><c:out value="${s.email}"/></td><td><c:out value="${s.course.name}"/></td><td><a href="${pageContext.request.contextPath}/students?action=edit&amp;id=${s.id}">Edit</a><form method="post" style="display:inline" onsubmit="return confirm('Delete this student?')"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${s.id}"><button>Delete</button></form></td></tr></c:forEach></table></main></body></html>
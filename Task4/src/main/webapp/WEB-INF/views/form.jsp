<%@ page contentType="text/html; charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><!doctype html><html><head><title>Student Form</title><link rel="stylesheet" href="${pageContext.request.contextPath}/style.css"></head><body><main><h1>Student Form</h1><form method="post" action="${pageContext.request.contextPath}/students"><input type="hidden" name="action" value="save"><input type="hidden" name="id" value="${student.id}"><label>Enrollment <input name="enrollmentNo" value="<c:out value='${student.enrollmentNo}'/>" required maxlength="30"></label><label>Full name <input name="fullName" value="<c:out value='${student.fullName}'/>" required maxlength="120"></label><label>Email <input name="email" type="email" value="<c:out value='${student.email}'/>" required></label><label>Course <select name="courseId" required><c:forEach items="${courses}" var="c"><option value="${c.id}" ${student.course.id == c.id ? 'selected="selected"' : ''}><c:out value="${c.name}"/></option></c:forEach></select></label><button>Save</button></form><a href="${pageContext.request.contextPath}/students">Back</a></main></body></html>
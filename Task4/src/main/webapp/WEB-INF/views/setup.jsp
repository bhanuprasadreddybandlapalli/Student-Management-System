<%@ page contentType="text/html; charset=UTF-8" %><!doctype html><html><head><title>Initial Setup</title><link rel="stylesheet" href="${pageContext.request.contextPath}/style.css"></head><body><main><h1>First-time Admin Setup</h1><p>Use the SMS_SETUP_TOKEN configured on the server. Setup works only when there are no admins.</p><p class="error">${error}</p><form method="post"><label>Setup token <input name="token" type="password" required></label><label>Username <input name="username" required minlength="3"></label><label>Password <input name="password" type="password" required minlength="10"></label><button>Create admin</button></form></main></body></html>